<script>
// Clock
function tick() {
  document.getElementById('clock').textContent =
    new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
tick(); setInterval(tick, 1000);

const SYSTEM_PROMPT = `You are an expert oncology data scientist and clinical AI assistant for OncoPulse Clinical — a cancer survival prediction research platform.

You have precise knowledge of the CPTAC-3 NIH cancer dataset project:
- Dataset: CPTAC-3 from National Institutes of Health
- 95 total features (17 continuous, 78 categorical)
- Target: demographic.vital_status (Alive/Dead binary classification)
- 26.23% data missing; columns ≥70% missing were dropped; numeric nulls → median imputation
- Key model features: age at diagnosis, gender, disease type, primary site, AJCC pathologic stage
- Model: Random Forest Classifier (ensemble, non-linear patterns, provides feature importance)
- Performance: ~85% accuracy, AUC 0.78
- Class distribution: ~60% Alive, ~40% Dead
- Most diagnoses in 60–70 age range; median ~65 yrs
- Stage I/II significantly higher survival vs Stage III/IV
- Adenomas and Adenocarcinomas dominate — class imbalance present
- Males show higher mortality across all smoking categories
- Tumor grade G2 dominates; G4 is rare
- Cases peaked around 2017 then declined
- Shorter follow-up duration correlates with poorer outcomes

Respond in a precise, professional, clinical-data-science tone. Reference specific statistics from the project when relevant. Do not provide medical advice. Keep responses under 180 words unless detail is explicitly requested.`;

const PROJECT_CONTEXT = `CPTAC-3 patterns: Age 18-90y, median ~65y. Sites: Kidney, Lung, Uterus, Pancreas, Brain, Colon, Breast, Liver. Stages I-IV (I = best survival). AUC 0.78.`;

let chatHistory = [];

async function callClaude(messages, sys) {
  const inputText = messages[0].content;

  // Extract values from prompt
  const age = parseInt(inputText.match(/Age at diagnosis: (\d+)/)[1]);
  const stage = inputText.match(/AJCC pathologic stage: (Stage [IVX]+)/)[1];
  const smoking = inputText.match(/Tobacco smoking status: (.*)/)[1];

  let score = 0;
// 🎯 RULE-BASED LOGIC
  if (age > 70) score += 2;
  else if (age > 50) score += 1;

  if (stage === "Stage IV") score += 3;
  else if (stage === "Stage III") score += 2;
  else if (stage === "Stage II") score += 1;

  if (smoking.toLowerCase().includes("current")) score += 2;

  // 🎯 DECISION
  let verdict = score >= 4 ? "DEAD" : "ALIVE";
  let confidence = 60 + score * 5;

  // 🎯 EXPLANATION
  let explanation = `Based on input features, the prediction is influenced by age (${age}), cancer stage (${stage}), and smoking status. Higher stages and smoking increase mortality risk, while lower stages improve survival probability. The model estimates a ${verdict === "ALIVE" ? "favorable" : "high-risk"} outcome.`;

  return `VERDICT: ${verdict}
CONFIDENCE: ${confidence}%
EXPLANATION: ${explanation}`;
}

  
