<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>OncoPulse Clinical — CPTAC-3 Survival Predictor</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #f0f2f5;
  --surface:   #ffffff;
  --surface2:  #f7f8fa;
  --border:    #d6dae3;
  --border2:   #bfc5d2;
  --navy:      #0d2340;
  --navy2:     #1a3a5c;
  --blue:      #1565c0;
  --blue-l:    #e8f0fe;
  --teal:      #00796b;
  --teal-l:    #e0f2f1;
  --red:       #c62828;
  --red-l:     #ffebee;
  --amber:     #e65100;
  --amber-l:   #fff3e0;
  --text:      #1a1f2e;
  --text2:     #3d4a5c;
  --muted:     #6b7a90;
  --muted2:    #9aa3b0;
  --r:         6px;
  --r2:        10px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
  padding-bottom: 40px;
  overflow-x: hidden;
}

/* ── TOP SYSTEM BAR ── */
.sys-bar {
  background: var(--navy);
  color: rgba(255,255,255,.65);
  font-size: 11px;
  letter-spacing: .04em;
  padding: 5px 32px;
  display: flex; align-items: center; justify-content: space-between;
}
.sys-bar .sys-left { display: flex; gap: 24px; align-items: center; }
.sys-dot { width: 6px; height: 6px; border-radius: 50%; background: #4caf50; display: inline-block; margin-right: 5px; }
.sys-dot.amber { background: #ffc107; }

/* ── MAIN HEADER ── */
header {
  background: var(--surface);
  border-bottom: 3px solid var(--navy);
  padding: 0 32px;
  display: flex; align-items: center; justify-content: space-between;
  height: 62px;
}

.logo-block { display: flex; align-items: center; gap: 14px; }
.logo-icon {
  width: 38px; height: 38px; border-radius: var(--r);
  background: var(--navy);
  display: flex; align-items: center; justify-content: center;
}
.logo-icon svg { width: 22px; height: 22px; }
.logo-text { font-size: 17px; font-weight: 700; color: var(--navy); letter-spacing: -.01em; }
.logo-text span { color: var(--blue); }
.logo-sub { font-size: 10px; color: var(--muted); letter-spacing: .07em; text-transform: uppercase; margin-top: 1px; }

.header-right { display: flex; align-items: center; gap: 10px; }
.hdr-badge {
  font-size: 10px; font-weight: 600; letter-spacing: .06em;
  text-transform: uppercase; padding: 4px 10px;
  border-radius: 3px; border: 1px solid;
}
.hdr-badge.nih  { color: var(--blue); border-color: #90caf9; background: var(--blue-l); }
.hdr-badge.ver  { color: var(--teal); border-color: #80cbc4; background: var(--teal-l); }

/* ── NAV TABS ── */
.nav-tabs {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0 32px;
  display: flex; gap: 0;
}
.nav-tab {
  padding: 11px 20px; font-size: 11.5px; font-weight: 500;
  color: var(--muted); cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color .15s, border-color .15s;
  letter-spacing: .03em; text-transform: uppercase;
}
.nav-tab.active { color: var(--blue); border-bottom-color: var(--blue); font-weight: 600; }
.nav-tab:hover:not(.active) { color: var(--text2); }

/* ── PAGE CONTENT ── */
.content {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 20px;
}
/* ── ALERT ── */
.alert-banner {
  background: var(--amber-l);
  border: 1px solid #ffcc80;
  border-left: 4px solid var(--amber);
  border-radius: var(--r);
  padding: 10px 16px;
  font-size: 11.5px; color: #5d3200;
  display: flex; align-items: flex-start; gap: 10px;
  margin-bottom: 20px; line-height: 1.6;
}
.alert-banner svg { flex-shrink: 0; width: 16px; height: 16px; margin-top: 1px; }

/* ── METRICS ROW ── */
.metrics-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px; margin-bottom: 22px;
}
.metric-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r2);
  padding: 16px 20px;
  position: relative; overflow: hidden;
}
.metric-card::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  width: 4px;
}
.metric-card.blue::before  { background: var(--blue); }
.metric-card.teal::before  { background: var(--teal); }
.metric-card.navy::before  { background: var(--navy); }
.metric-card.amber::before { background: var(--amber); }

.metric-label { font-size: 10px; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); font-weight: 600; margin-bottom: 6px; }
.metric-val { font-size: 28px; font-weight: 700; color: var(--navy); letter-spacing: -.02em; font-family: 'IBM Plex Mono', monospace; line-height: 1; }
.metric-sub { font-size: 11px; color: var(--muted2); margin-top: 5px; }

/* ── LAYOUT GRID ── */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

@media (max-width: 900px) {
  .grid-2 { grid-template-columns: 1fr; }
  .metrics-row { grid-template-columns: repeat(2,1fr); }
  .content { padding: 16px 16px 60px; }
  .nav-tabs, header, .sys-bar { padding-left: 16px; padding-right: 16px; }
}

/* ── PANEL ── */
.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r2);
  overflow: hidden;
  .panel {
  width: 100%;
  min-width: 0;
}
}

.panel-header {
  background: var(--navy);
  color: #fff; padding: 10px 18px;
  display: flex; align-items: center; gap: 10px;
}
.panel-header svg { width: 14px; height: 14px; stroke: rgba(255,255,255,.65); fill: none; stroke-width: 2; flex-shrink: 0; }
.panel-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .09em; }
.panel-sub { font-size: 10px; color: rgba(255,255,255,.45); margin-left: auto; font-style: italic; }

.panel-body { padding: 22px; }

/* ── FORM ── */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.form-row.single { grid-template-columns: 1fr; }

.field { display: flex; flex-direction: column; gap: 5px; }
.field label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
.field label .req { color: var(--red); margin-left: 2px; }

.field input,
.field select {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  padding: 9px 12px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 13px; outline: none;
  transition: border-color .15s, box-shadow .15s;
  width: 100%; appearance: auto;
}
.field input:focus, .field select:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(21,101,192,.1);
}

.range-row { display: flex; align-items: center; gap: 12px; }
.range-row input[type=range] { flex: 1; accent-color: var(--blue); cursor: pointer; height: 4px; }
.range-badge {
  background: var(--blue-l); color: var(--blue);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 13px; font-weight: 600;
  padding: 4px 10px; border-radius: 4px;
  min-width: 54px; text-align: center; border: 1px solid #c5d8f8;
}

.section-divider {
  display: flex; align-items: center; gap: 10px;
  margin: 18px 0 14px;
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .1em; color: var(--muted2);
}
.section-divider::before, .section-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--border);
}

.submit-btn {
  width: 100%; padding: 12px;
  background: var(--navy); color: #fff;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 12.5px; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  border: none; border-radius: var(--r);
  cursor: pointer; margin-top: 6px;
  transition: background .15s, transform .1s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.submit-btn:hover { background: var(--navy2); }
.submit-btn:active { transform: scale(.99); }
.submit-btn:disabled { background: var(--border2); color: var(--muted2); cursor: not-allowed; }

/* ── RESULT ── */
#result-box {
  display: none;
  margin-top: 16px;
  border: 1px solid var(--border);
  border-radius: var(--r2);
  overflow: hidden;
  animation: slideIn .3s ease;
}
@keyframes slideIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

.result-header {
  padding: 14px 18px;
  display: flex; align-items: center; gap: 14px;
  border-bottom: 1px solid var(--border);
}
.result-header.alive { background: var(--teal-l); border-bottom-color: #b2dfdb; }
.result-header.dead  { background: var(--red-l);  border-bottom-color: #ffcdd2; }

.result-icon {
  width: 44px; height: 44px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.alive .result-icon { background: var(--teal); }
.dead  .result-icon { background: var(--red); }
.result-icon svg { width: 22px; height: 22px; stroke: #fff; fill: none; stroke-width: 2.5; }

.result-meta { flex: 1; }
.result-verdict { font-size: 14px; font-weight: 700; }
.alive .result-verdict { color: var(--teal); }
.dead  .result-verdict { color: var(--red); }
.result-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }

.conf-circle {
  width: 58px; height: 58px; border-radius: 50%;
  border: 3px solid;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 14px; font-weight: 700; flex-shrink: 0;
}
.alive .conf-circle { border-color: var(--teal); color: var(--teal); }
.dead  .conf-circle { border-color: var(--red);  color: var(--red); }
.conf-lbl-small { font-size: 8px; letter-spacing: .05em; font-weight: 400; color: var(--muted); margin-top: 2px; font-family: 'IBM Plex Sans', sans-serif; }

.result-body { padding: 16px 18px; background: var(--surface); }
.result-body-label { font-size: 10px; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); font-weight: 600; margin-bottom: 8px; }
#result-analysis { font-size: 13px; color: var(--text2); line-height: 1.8; white-space: pre-wrap; }

.typing-cursor::after { content: '▋'; animation: blink .7s infinite; color: var(--blue); }
@keyframes blink { 0%,100%{opacity:1}50%{opacity:0} }

/* ── CHAT ── */
.chat-body { padding: 18px; }

.chat-messages {
  height: 255px; overflow-y: auto;
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--r); padding: 12px;
  display: flex; flex-direction: column; gap: 10px;
  margin-bottom: 12px; scroll-behavior: smooth;
}
.chat-messages::-webkit-scrollbar { width: 3px; }
.chat-messages::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

.msg {
  max-width: 88%; font-size: 12.5px; line-height: 1.7;
  padding: 9px 13px; border-radius: 8px;
  animation: slideIn .2s ease;
}
.msg.user { align-self: flex-end; background: var(--navy); color: rgba(255,255,255,.9); border-bottom-right-radius: 3px; }
.msg.ai   { align-self: flex-start; background: var(--surface); color: var(--text2); border: 1px solid var(--border); border-bottom-left-radius: 3px; }

.quick-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
.quick-chip {
  font-size: 11px; padding: 5px 11px; border-radius: 4px;
  border: 1px solid var(--border2); background: var(--surface2);
  color: var(--text2); cursor: pointer;
  transition: border-color .15s, background .15s, color .15s;
}
.quick-chip:hover { border-color: var(--blue); background: var(--blue-l); color: var(--blue); }

.chat-input-row { display: flex; gap: 8px; }
.chat-input-row input {
  flex: 1; background: var(--surface2); border: 1px solid var(--border);
  border-radius: var(--r); color: var(--text); padding: 9px 13px;
  font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; outline: none;
}
.chat-input-row input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(21,101,192,.1); }
.chat-input-row input::placeholder { color: var(--muted2); }
.chat-input-row button {
  background: var(--blue); color: #fff;
  font-family: 'IBM Plex Sans', sans-serif; font-weight: 600;
  font-size: 12px; border: none; border-radius: var(--r);
  padding: 9px 18px; cursor: pointer; white-space: nowrap;
  transition: background .15s;
}
.chat-input-row button:hover { background: #0d47a1; }
.chat-input-row button:disabled { background: var(--border2); cursor: not-allowed; }

/* ── EHR TABLE ── */
.ehr-table { width: 100%; border-collapse: collapse; }
.ehr-table th {
  background: var(--surface2); color: var(--muted);
  font-size: 10px; text-transform: uppercase; letter-spacing: .08em;
  padding: 9px 16px; text-align: left; border-bottom: 1px solid var(--border);
  font-weight: 700;
}
.ehr-table td {
  padding: 9px 16px; font-size: 13px; color: var(--text2);
  border-bottom: 1px solid var(--border);
}
.ehr-table tr:last-child td { border-bottom: none; }
.ehr-table tr:hover td { background: #f4f6f9; }
.ehr-table .mono { font-family: 'IBM Plex Mono', monospace; color: var(--navy); font-weight: 500; }

.tag-pill {
  display: inline-block; padding: 2px 8px; border-radius: 3px;
  font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em;
}
.tag-pill.blue  { background: var(--blue-l);  color: var(--blue); }
.tag-pill.teal  { background: var(--teal-l);  color: var(--teal); }
.tag-pill.amber { background: var(--amber-l); color: var(--amber); }

/* ── DISCLAIMER ── */
.disclaimer {
  background: var(--surface); border: 1px solid var(--border);
  border-left: 4px solid var(--muted2);
  border-radius: var(--r); padding: 12px 16px;
  font-size: 11.5px; color: var(--muted); line-height: 1.75;
  margin-top: 20px;
}

/* ── SPINNER ── */
.spinner { display: inline-block; width: 13px; height: 13px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: spin .55s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>

<!-- SYSTEM BAR -->
<div class="sys-bar">
  <div class="sys-left">
    <span><span class="sys-dot"></span>System Online</span>
    <span>NIH · CPTAC-3 Research Portal</span>
    <span>Session: CLN-2026-A</span>
  </div>
  <span id="clock">--:--:--</span>
</div>

<!-- HEADER -->
<header>
  <div class="logo-block">
    <div class="logo-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8">
        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
      </svg>
    </div>
    <div>
      <div class="logo-text">Onco<span>Pulse</span> Clinical</div>
      <div class="logo-sub">Cancer Survival Prediction System</div>
    </div>
  </div>
  <div class="header-right">
    <div class="hdr-badge nih">NIH · CPTAC-3</div>
    <div class="hdr-badge ver">RF Model · v1.0</div>
  </div>
</header>

<!-- NAV -->
<div class="nav-tabs">
  <div class="nav-tab active">Prediction Console</div>
  <div class="nav-tab">Dataset Analytics</div>
  <div class="nav-tab">Model Report</div>
  <div class="nav-tab">Clinical Assistant</div>
</div>

<!-- CONTENT -->
<div class="content">

  <!-- ALERT -->
  <div class="alert-banner">
    <svg viewBox="0 0 24 24" fill="#e65100"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
    <span><strong>Research &amp; Educational Tool Only:</strong> OncoPulse predictions are generated by an AI model trained on CPTAC-3 clinical data. This system is not a certified medical device and must not inform patient care decisions. Always consult a licensed oncologist.</span>
  </div>

  <!-- METRICS -->
  <div class="metrics-row">
    <div class="metric-card blue">
      <div class="metric-label">Model Accuracy</div>
      <div class="metric-val">85.2%</div>
      <div class="metric-sub">Random Forest · Test Set</div>
    </div>
    <div class="metric-card teal">
      <div class="metric-label">ROC AUC Score</div>
      <div class="metric-val">0.78</div>
      <div class="metric-sub">Strong discriminative ability</div>
    </div>
    <div class="metric-card navy">
      <div class="metric-label">Clinical Features</div>
      <div class="metric-val">95</div>
      <div class="metric-sub">17 continuous · 78 categorical</div>
    </div>
    <div class="metric-card amber">
      <div class="metric-label">Data Source</div>
      <div class="metric-val">NIH</div>
      <div class="metric-sub">CPTAC-3 Initiative</div>
    </div>
  </div>

  <!-- MAIN GRID -->
  <div class="grid-2">

    <!-- PATIENT INTAKE -->
    <div class="panel">
      <div class="panel-header">
        <svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 10h8M8 14h5"/><path d="M12 2v4"/></svg>
        <span class="panel-title">Patient Clinical Intake</span>
        <span class="panel-sub">* Required fields</span>
      </div>
      <div class="panel-body">

        <div class="section-divider">Demographics</div>

        <div class="form-row">
          <div class="field">
            <label>Age at Diagnosis <span class="req">*</span></label>
            <div class="range-row">
              <input type="range" id="age" min="18" max="90" value="62"
                oninput="document.getElementById('age-val').textContent=this.value+'y'"/>
              <div class="range-badge" id="age-val">62y</div>
            </div>
          </div>
          <div class="field">
            <label>Biological Sex <span class="req">*</span></label>
            <select id="gender">
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
        </div>

        <div class="form-row single">
          <div class="field">
            <label>Tobacco / Smoking Status</label>
            <select id="smoking">
              <option value="Never">Never Smoked</option>
              <option value="Lifelong Non-Smoker">Lifelong Non-Smoker</option>
              <option value="Current smoker">Current Smoker</option>
              <option value="Current Reformed Smoker">Former Smoker (Reformed)</option>
            </select>
          </div>
        </div>

        <div class="section-divider">Oncology Profile</div>

        <div class="form-row">
          <div class="field">
            <label>Primary Site <span class="req">*</span></label>
            <select id="site">
              <option value="Kidney">Kidney</option>
              <option value="Lung">Lung</option>
              <option value="Uterus">Uterus</option>
              <option value="Pancreas">Pancreas</option>
              <option value="Brain">Brain</option>
              <option value="Colon">Colon</option>
              <option value="Breast">Breast</option>
              <option value="Liver">Liver</option>
              <option value="Larynx">Larynx</option>
            </select>
          </div>
          <div class="field">
            <label>AJCC Pathologic Stage <span class="req">*</span></label>
            <select id="stage">
              <option value="Stage I">Stage I — Localized</option>
              <option value="Stage II">Stage II — Regional</option>
              <option value="Stage III" selected>Stage III — Advanced Regional</option>
              <option value="Stage IV">Stage IV — Metastatic</option>
            </select>
          </div>
        </div>

        <div class="form-row single">
          <div class="field">
            <label>Histologic Disease Type <span class="req">*</span></label>
            <select id="disease">
              <option value="Adenomas and Adenocarcinomas">Adenomas and Adenocarcinomas</option>
              <option value="Epithelial Neoplasms, NOS">Epithelial Neoplasms, NOS</option>
              <option value="Squamous Cell Neoplasms">Squamous Cell Neoplasms</option>
              <option value="Cystic, Mucinous and Serous Neoplasms">Cystic / Mucinous / Serous Neoplasms</option>
              <option value="Ductal and Lobular Neoplasms">Ductal and Lobular Neoplasms</option>
              <option value="Gliomas">Gliomas</option>
            </select>
          </div>
        </div>

        <button class="submit-btn" id="predict-btn" onclick="runPrediction()">
          Run Survival Prediction
        </button>

        <!-- RESULT -->
        <div id="result-box">
          <div class="result-header" id="result-header">
            <div class="result-icon" id="result-icon">
              <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <div class="result-meta">
              <div class="result-verdict" id="result-verdict">—</div>
              <div class="result-sub" id="result-sub">—</div>
            </div>
            <div>
              <div class="conf-circle" id="conf-circle">
                <span id="conf-val">—</span>
                <span class="conf-lbl-small">Confidence</span>
              </div>
            </div>
          </div>
          <div class="result-body">
            <div class="result-body-label">Clinical AI Interpretation</div>
            <div id="result-analysis"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- AI CHAT ASSISTANT -->
    <div class="panel">
      <div class="panel-header">
